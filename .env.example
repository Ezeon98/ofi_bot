# ── WhatsApp Business Cloud API ────────────────────────────────────────
WHATSAPP_TOKEN=your-whatsapp-token
PHONE_NUMBER_ID=your-phone-number-id
WABA_ID=your-waba-id
VERIFY_TOKEN=your-verify-token
BOT_PHONE_NUMBER=5491100000000

# ── MercadoPago ───────────────────────────────────────────────────────
MP_ACCESS_TOKEN=your-mp-access-token
MP_PUBLIC_KEY=your-mp-public-key
MP_PLAN_MONTHLY_TRIAL=
MP_PLAN_MONTHLY_NO_TRIAL=
MP_PLAN_ANNUAL_TRIAL=
MP_PLAN_ANNUAL_NO_TRIAL=
MP_PREMIUM_MONTHLY_TRIAL=
MP_PREMIUM_MONTHLY_NO_TRIAL=
MP_PREMIUM_ANNUAL_TRIAL=
MP_PREMIUM_ANNUAL_NO_TRIAL=
MP_WEBHOOK_SECRET=

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/whatsapp_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=whatsapp_bot

# ── App ───────────────────────────────────────────────────────────────
BASE_URL=https://your-domain.com
PORT=8000
DEBUG=false

# ── Redis (deduplication) ─────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── OpenAI ────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_KEY_SECONDARY=

# ── Admin ─────────────────────────────────────────────────────────────
ADMIN_PHONE=5491100000000
